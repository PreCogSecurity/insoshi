# Insoshi Environment Configuration
# Copy to .env and customize for your deployment
# 
# This file lists every environment variable referenced in config/
# Replace placeholder values with your own before running the app.

# Database configuration
DATABASE_HOST=localhost
DATABASE_USERNAME=root
DATABASE_PASSWORD=
DATABASE_NAME=insoshi_development

# Rails environment
RAILS_ENV=development

# Default admin password - MUST be changed from placeholder on first run
# This replaces the hardcoded "admin" in app/controllers/application.rb
DEFAULT_ADMIN_PASSWORD=change_me_to_a_secure_password

# Session encryption keep secret - generate a new one per deployment
# This replaces the cookie session store secret
SESSION_SECRET=change_me_to_a_secure_random_string

# File uploads / attachments
# If using S3 for storage, configure these:
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# S3_BUCKET=your_bucket_name

# Search (Sphinx)
# SPHINX_HOST=localhost
# SPHINX_PORT=9312